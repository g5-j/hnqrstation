; Engine configuration file.
; World scale: 1 Godot unit = 1 metre.

config_version=5

[application]

config/name="Hnqrstation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.2, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/goygi/plugin.cfg")

[autoload]

GoyGIRuntime="*res://addons/goygi/runtime/goygi_runtime.gd"

[goygi/options]

gi_enabled=true
gi_power=1.0
gi_quality=0
gi_resolution=0
gi_vpls=32
gi_rays=0
gi_update_budget=0
gi_bounces=2
gi_bounce_strength=1.6
gi_update_rate=15
gi_response=0.7
gi_smoothing=0.75
gi_stabilization=1
gi_spatial_filter=1
gi_adaptive=true
gi_filtering=0
gi_transition=1
gi_detail_ao=false
gi_ambient=0.04
gi_ambient_color=0
gi_environment=1.0
gi_chunk_mode=1
gi_chunk_distance=24.0
gi_near_mode=0
gi_unlimited_distance=false
gi_auto_budget=true
gi_debug_view=0
gi_show_vpls=false
gi_show_rays=false
gi_show_regions=false
developer_mode=false
normal_maps=false
fast_triplanar=true
max_fps=60

[goygi/runtime]

auto_attach=true
auto_emitters=true
convert_materials=true
