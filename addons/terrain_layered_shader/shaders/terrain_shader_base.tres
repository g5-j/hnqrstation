[gd_resource type="Shader" format=3]

[resource]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\n\nuniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;\nuniform vec4 albedo : source_color = vec4(1.0, 1.0, 1.0, 1.0);\nuniform vec2 uv_terrain_scale = vec2(32.0, 32.0);\nuniform vec2 uv_terrain_offset = vec2(0.0, 0.0);\nuniform float roughness : hint_range(0.0, 1.0) = 0.94;\nuniform float metallic : hint_range(0.0, 1.0) = 0.0;\nuniform float specular : hint_range(0.0, 1.0) = 0.12;\n\nvarying vec2 terrain_uv;\n\nvoid vertex() {\n    terrain_uv = UV * uv_terrain_scale + uv_terrain_offset;\n}\n\nvoid fragment() {\n    vec3 base_color = texture(texture_albedo, terrain_uv).rgb;\n    ALBEDO = base_color * albedo.rgb;\n    ROUGHNESS = roughness;\n    METALLIC = metallic;\n    SPECULAR = specular;\n}\n"
